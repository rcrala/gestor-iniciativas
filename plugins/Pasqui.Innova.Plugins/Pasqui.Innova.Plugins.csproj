<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 = consumible por net462 (Dataverse) y net8.0 (tests cross-platform) -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Pasqui.Innova.Plugins</RootNamespace>
    <AssemblyName>Pasqui.Innova.Plugins</AssemblyName>
    <Description>Plug-ins de servidor para INNOVA (Dataverse)</Description>
    <Company>Pasqui</Company>
    <Product>INNOVA</Product>
    <Version>1.0.0</Version>
    <!-- Strong-name requerido por Dataverse para registrar plugin assembly -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Pasqui.Innova.Plugins.snk</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
    <!-- NU1701: CrmSdk.CoreAssemblies solo viene en net46x; netstandard2.0 lo consume bien por shim -->
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.49" />
  </ItemGroup>

</Project>
