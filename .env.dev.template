# =============================================================================
# .env.dev.template - INNOVA Service Principal (DEV)
# =============================================================================
# Plantilla committed. Copiar a .env.dev (gitignored) y rellenar con los valores
# reales del SP "INNOVA-SP-DEV" creado en Entra ID.
#
# Uso:
#   1. Copy-Item .env.dev.template .env.dev
#   2. Rellenar las 4 variables abajo con los valores capturados en Azure Portal
#   3. Ejecutar: pwsh ./scripts/setup/auth-sp.ps1 -Environment dev
#
# CRITICO: .env.dev NUNCA debe commitearse (.gitignore lo cubre via .env.*).
# Para CI/CD las mismas variables van a GitHub Secrets (ver runbook 05).
# Rotar el secret cada 24 meses (ver runbook 05 seccion "Rotacion").
# =============================================================================

# Tenant de Entra ID (Microsoft Entra ID -> Overview -> Tenant ID)
INNOVA_TENANT_ID=<<GUID tenant Grupo Pasqui>>

# Application (client) ID del SP (Entra ID -> App registrations -> INNOVA-SP-DEV -> Overview)
INNOVA_SP_CLIENT_ID=<<GUID application client id>>

# Client Secret VALUE (Certificates & secrets -> columna Value, NO Secret ID)
# Solo visible UNA vez al crearlo. Si lo perdiste, generar otro.
INNOVA_SP_CLIENT_SECRET=<<secret value rellenar>>

# URL del environment DEV (visible en Power Platform Admin Center)
INNOVA_DEV_URL=https://org93905a7d.crm.dynamics.com
